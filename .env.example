# CloudSOC Runtime Configuration
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# Security & Session Secrets (change in production)
SESSION_SECRET="replace-with-32-byte-random-hex-secret"

# Database Configuration
# Live AI Studio SQLite storage (schema-aligned with PostgreSQL migrations)
DATABASE_PATH="./data/cloudsoc.db"
# PostgreSQL Connection String for Cloud Deployment (Cloud SQL / RDS / Render / Azure)
DATABASE_URL="postgresql://cloudsoc_user:CHANGE_ME@localhost:5432/cloudsoc"

# Optional External Threat Intelligence APIs (falls back to Local Demonstration Mode when empty)
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""

# Optional Gemini API Key (only if AI features are later enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
